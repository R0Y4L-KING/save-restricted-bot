# ==========================================
# Save Restricted Content Bot - Environment
# Copy this file to .env and fill in your values.
# On Render, add these under: Service -> Environment -> Add Environment Variable
# ==========================================

# --- Telegram Bot Credentials (required) ---
# Bot token from @BotFather
BOT_TOKEN=
# From https://my.telegram.org -> API development tools
API_ID=
API_HASH=

# --- Admins (required) ---
# Your Telegram user ID(s), comma separated. Get it from @userinfobot
ADMINS=

# --- Database (required) ---
# MongoDB connection string (MongoDB Atlas free cluster works)
DB_URI=
DB_NAME=SaveRestricted2

# --- Logging (required) ---
# Numeric ID of the log channel, e.g. -1001234567890 (make the bot an admin there)
LOG_CHANNEL=

# --- Error handling (optional) ---
ERROR_MESSAGE=True

# --- Premium / payment screen ---
# Image shown on the subscription screen
SUBSCRIPTION=https://graph.org/file/242b7f1b52743938d81f1.jpg
# UPI id used on the payment screen
UPI_ID=20213904@axl
# QR code image URL used on the payment screen (auto-generated from the UPI id)
QR_CODE=https://raw.githubusercontent.com/R0Y4L-KING/save-restricted-bot/main/assets/upi_qr.png
# UPI payment page opened by the "Pay Now" button
PAY_URL=https://r0y4l-king.github.io/upi-pay/

# --- Start screen photos ---
# Main photo shown on /start
START_PHOTO=https://raw.githubusercontent.com/R0Y4L-KING/save-restricted-bot/main/assets/start_banner.jpg
# Used if the main photo fails to load
START_PHOTO_FALLBACK=https://raw.githubusercontent.com/R0Y4L-KING/save-restricted-bot/main/assets/start_fallback.jpg

# --- Ad / token verification (shortener gate) ---
# Master switch: free users must complete a shortener before downloading
IS_VERIFY=True
# Shortener / ad network
SHORTLINK_URL=vipshort.in
# SECRET: your shortener API key (never commit this)
SHORTLINK_API=
# How long a user stays verified after completing it (seconds). 21600 = 6 hours
VERIFY_EXPIRE=21600
# Tutorial video shown on the verify screen
TUT_VID=https://t.me/ModAppsKing
# Public base URL of this service (used for the anti-bypass gateway page).
# On Render this is read from RENDER_EXTERNAL_URL automatically - only set it
# manually if you use a custom domain, e.g. https://bot.example.com
PUBLIC_URL=
# Anti-bypass: the security page only loads when the browser arrives FROM the
# shortener (Referer header). Set False only if legit users ever get blocked.
REQUIRE_REFERER=True

# --- Keep alive (Render sets PORT automatically) ---
# PORT=8080
